// AI Video Studio - Database Schema
// V1 uses SQLite. Kept relationally simple so a future move to
// PostgreSQL only requires changing the datasource provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id                String   @id @default(cuid())
  title             String
  description       String   @default("")
  topic             String   @default("")
  duration          Int      @default(60) // target duration, in seconds
  mediaType         String   @default("VIDEO") // VIDEO | IMAGE
  clipDurationSec   Float    @default(10) // per-clip duration, video mode
  imageDurationSec  Float    @default(5) // per-image display duration, image mode
  narrationRequired Boolean  @default(false)
  musicRequired     Boolean  @default(false)
  aspectRatio       String   @default("16:9") // 16:9 | 9:16 | 1:1 | 4:3
  resolution        String   @default("1920x1080")
  fps               Int      @default(30)
  language          String   @default("English")
  audience          String   @default("General")
  style             String   @default("3D Cartoon")
  videoType         String   @default("Educational")
  status            String   @default("DRAFT") // DRAFT | GENERATING | READY | FAILED
  agentState        String   @default("IDLE")
  storagePath       String
  scriptJson        String   @default("null") // serialized story structure
  styleBible        String   @default("null") // serialized StyleBible
  storyContext      String   @default("") // overall narrative arc / continuity notes
  // Opening / end screen (branding) - logo, name, font etc. come from the Channel
  introEnabled          Boolean @default(true)
  outroEnabled          Boolean @default(true)
  brandBackgroundPath   String  @default("") // uploaded per-video background image (absolute path), "" = fall back to a blurred clip frame
  brandBackgroundPrompt String  @default("") // generated prompt for that background image
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  scenes        Scene[]
  characters    Character[]
  environments  Environment[]
  promptVersions PromptVersion[]
  mediaAssets   MediaAsset[]
  timelineItems TimelineItem[]
  audioTracks   AudioTrack[]
  renders       Render[]
  assets        Asset[]
  tasks         AgentTask[]
  logs          AgentLog[]
  revisions     Revision[]
  messages      ChatMessage[]
}

model Scene {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneNumber           Int
  duration              Float    @default(5)
  startTime             Float    @default(0)
  endTime               Float    @default(0)
  narration             String   @default("")
  onScreenText          String   @default("")
  visualDescription     String   @default("")
  imagePrompt           String   @default("")
  videoPrompt           String   @default("")
  animationDirection    String   @default("")
  cameraDirection       String   @default("")
  composition           String   @default("") // framing/composition, mainly used for image prompts
  negativeInstructions  String   @default("")
  continuityNotes       String   @default("")
  characters            String   @default("[]") // JSON array of characterKeys referenced by this scene
  environmentKey        String   @default("") // reference into the Environment bible
  transition            String   @default("fade")
  soundEffects          String   @default("")
  status                String   @default("PLANNED") // PLANNED|GENERATING|READY|FAILED|REGENERATING|APPROVED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  promptVersions PromptVersion[]
  timelineItems  TimelineItem[]

  @@unique([projectId, sceneNumber])
  @@index([projectId])
}

model Character {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterKey  String   // stable id used in prompts, e.g. "alpaca_01"
  name          String
  appearance    String   @default("")
  age           String   @default("")
  colors        String   @default("")
  clothing      String   @default("")
  personality   String   @default("")
  visualStyle   String   @default("")
  environment   String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, characterKey])
  @@index([projectId])
}

/** The Environment Bible - mirrors Character so recurring settings stay visually consistent across scenes. */
model Environment {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environmentKey String   // stable id used in prompts, e.g. "red_barn"
  name           String
  description    String   @default("")
  lighting       String   @default("")
  colors         String   @default("")
  props          String   @default("")
  timeOfDay      String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, environmentKey])
  @@index([projectId])
}

/** Historical snapshots of a scene's prompt fields, written before every overwrite (spec: "Scene 05 v1/v2/v3"). */
model PromptVersion {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId              String
  scene                Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  version              Int
  visualDescription    String   @default("")
  imagePrompt          String   @default("")
  videoPrompt          String   @default("")
  animationDirection   String   @default("")
  cameraDirection      String   @default("")
  composition          String   @default("")
  negativeInstructions String   @default("")
  continuityNotes      String   @default("")
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@unique([sceneId, version])
  @@index([projectId])
  @@index([sceneId])
}

/** One row per uploaded (externally-generated) file - never something this app generated itself. */
model MediaAsset {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type            String   // IMAGE | VIDEO | AUDIO
  originalFilename String
  filePath        String
  width           Int?
  height          Int?
  durationSec     Float?
  aspectRatio     String   @default("")
  sizeBytes       Int      @default(0)
  status          String   @default("UPLOADED") // UPLOADED|PROBED|INVALID
  probeMetadata   String   @default("{}") // JSON blob: codec, fps, format, etc.
  matchedSceneNumber Int?
  createdAt       DateTime @default(now())

  timelineItems TimelineItem[]

  @@index([projectId])
}

/** The ordered assembly sequence FFmpeg concatenates into the final video. */
model TimelineItem {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mediaAssetId       String
  mediaAsset         MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  sceneId            String?
  scene              Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  kind               String   // IMAGE | VIDEO
  order              Int      @default(0)
  displayDurationSec Float?   // images: how long to show; videos: null = use probed duration
  trimStartSec       Float?
  trimEndSec         Float?
  fitMode            String   @default("FIT") // FIT | CROP | BLUR_BACKGROUND - never stretch
  transition         String   @default("cut")
  startTime          Float    @default(0)
  endTime            Float    @default(0)
  active             Boolean  @default(true) // soft delete - keeps history/undo possible
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([projectId])
  @@index([sceneId])
}

/** Uploaded narration/music - muxed in during assembly. No TTS/music generation API involved. */
model AudioTrack {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        String   // NARRATION | MUSIC
  filePath    String
  originalFilename String @default("")
  durationSec Float?
  volume      Float    @default(1)
  fadeInSec   Float    @default(0)
  fadeOutSec  Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

/** Internally-produced artifacts only (never AI-generated media): subtitles and thumbnails. */
model Asset {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          String   // SUBTITLE | THUMBNAIL
  version       Int      @default(1)
  status        String   @default("QUEUED") // QUEUED|PROCESSING|COMPLETED|FAILED
  provider      String   @default("internal")
  isMock        Boolean  @default(false)
  prompt        String   @default("")
  filePath      String   @default("")
  duration      Float?
  generationHash String  @default("")
  metadata      String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([generationHash])
}

/** One row per assembly run (spec: show duration/resolution/aspect ratio/item count/file size/validation). */
model Render {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filePath          String
  status            String   @default("PENDING") // PENDING|SUCCEEDED|FAILED
  durationSec       Float    @default(0)
  resolution        String   @default("")
  aspectRatio       String   @default("")
  fps               Float    @default(0)
  mediaItemCount    Int      @default(0)
  sizeBytes         Int      @default(0)
  hasAudio          Boolean  @default(false)
  hasSubtitles      Boolean  @default(false)
  validationIssues  String   @default("[]") // JSON array of strings
  createdAt         DateTime @default(now())

  @@index([projectId])
}

model AgentTask {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        String
  state       String   @default("PENDING") // PENDING|RUNNING|COMPLETED|FAILED|CANCELLED
  input       String   @default("{}")
  output      String   @default("{}")
  error       String?
  retryCount  Int      @default(0)
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model AgentLog {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  level      String   @default("info")
  agentState String   @default("")
  task       String   @default("")
  tool       String   @default("")
  message    String
  durationMs Int?
  data       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Revision {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary    String
  diff       String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role       String   // user | assistant | system | tool
  content    String
  toolCalls  String   @default("null")
  createdAt  DateTime @default(now())

  @@index([projectId])
}

/// The YouTube channel's branding, shared by every project's opening/end
/// screens. Single row for now (ChannelService.get upserts it); kept as its
/// own table so multiple channels can be added later without a data move.
model Channel {
  id               String   @id @default(cuid())
  name             String   @default("")
  logoPath         String   @default("") // opening logo; absolute path under <storage>/_channel/, "" = no logo
  endLogoPath      String   @default("") // wide end-screen logo, "" = use the opening logo
  openingMusicPath String   @default("") // music under the opening screen
  endAudioPath     String   @default("") // end-screen voice/CTA ("don't forget to like & share")
  fontPath         String   @default("") // uploaded .ttf/.otf for the opening text, "" = system serif
  likeButtonPath      String @default("") // custom button images; "" = the app's built-in buttons
  shareButtonPath     String @default("")
  subscribeButtonPath String @default("")
  textColor        String   @default("#FFFFFF")
  openingText      String   @default("Welcome to") // typed in before the logo pops in, "" = none
  introDurationSec Float    @default(6)
  outroDurationSec Float    @default(6)
  showTitleOnIntro Boolean  @default(false)
  musicVolume      Float    @default(0.5) // opening music level (0-1); the end-screen music bed runs at a fraction of it
  endBackground    String   @default("WHITE") // WHITE | VIDEO (the project's opening background)
  watermarkEnabled  Boolean @default(true) // opening logo in a corner during the video (after the opening, before the end screen)
  watermarkPosition String  @default("BOTTOM_RIGHT") // superseded by watermarkX/Y (free drag position); kept so existing rows migrate without data loss
  watermarkX        Float   @default(0.94) // logo centre, as a fraction of the frame width (dragged in the UI)
  watermarkY        Float   @default(0.9) // logo centre, as a fraction of the frame height
  watermarkSizePct  Float   @default(14) // logo height as % of the frame height
  watermarkOpacity  Float   @default(0.9)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
