# ============================================================
# AI Video Studio - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env - it holds secrets.
# ============================================================

# ---- Ollama Cloud (LLM) ----
# Get an API key at https://ollama.com (Settings -> API Keys)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b-cloud

# ---- FFmpeg ----
# There are no media-generation providers/API keys in this app - Ollama
# Cloud above is the only external service used. All image/video/narration/
# music is generated externally by you and uploaded; FFmpeg (below) does
# all local processing (normalization, image-to-video, concatenation,
# mixing, subtitles). Subtitle burn-in needs the drawtext filter
# (libfreetype), which Homebrew's plain `ffmpeg` formula is built WITHOUT.
# Install `brew install ffmpeg-full` and point these at its keg (it's
# keg-only, so it won't override the plain `ffmpeg` on your PATH). If your
# `ffmpeg`/`ffprobe` on PATH already have drawtext support, "ffmpeg" /
# "ffprobe" work fine too - just verify with `ffmpeg -filters | grep drawtext`.
FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe

# ---- Storage ----
# Resolved relative to the server process's cwd, which npm workspaces sets
# to server/ - so this points at the repo-root video-projects/ directory.
PROJECT_STORAGE_PATH=../video-projects

# ---- Agent ----
MAX_AGENT_ITERATIONS=100
MAX_TOOL_RETRIES=3
TOOL_TIMEOUT_MS=120000
LLM_TIMEOUT_MS=60000

# ---- Database ----
DATABASE_URL=file:./data/dev.db

# ---- Server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- Client ----
# Base URL the React app uses to reach the API (no secrets here).
VITE_API_BASE_URL=http://localhost:4000
